// Kantin Dapo Hakaksado — Firestore security rules
// Paste this whole file into Firebase console: Build > Firestore Database > Rules > Publish
//
// Default (requireLogin: true in config.js): only signed-in cashiers can read/write.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

// ---------------------------------------------------------------
// ONLY if you set requireLogin: false in config.js, use these
// "open" rules INSTEAD (anyone who finds your site URL can read and
// change your sales data — not recommended):
//
// rules_version = '2';
// service cloud.firestore {
//   match /databases/{database}/documents {
//     match /{document=**} {
//       allow read, write: if true;
//     }
//   }
// }
